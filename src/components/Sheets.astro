---
const response = await fetch(
  "https://opensheet.elk.sh/1RLlHrz6x6Bp7Bijh8A-nKRCAOWIPk-uypuq0CVle6EQ/1"
);
const data = await response.json();
---

<section class="container">
  <h2>Chicken Dinners</h2>
  {
    data
      .filter((dinner) => dinner.type === "Chicken")
      .map((dinner) => (
        <div class="card">
          <h3>{dinner.name}</h3>
          <p class="meta">Time: {dinner.time} · {dinner.lasts} nights</p>
          {dinner.instructions && (
            <details>
              <summary>Instructions</summary>
              <p>{dinner.instructions}</p>
            </details>
          )}
        </div>
      ))
  }
</section>
